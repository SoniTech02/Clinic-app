<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediFlow - Smart Queue & EMR System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <div id="root"></div>

    <script type="text/babel">
        // -----------------------------------------------------------------
        // ⚠️ TAMARO FIREBASE CONFIG AHIYA REPLACE KARO
        // -----------------------------------------------------------------
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT.firebaseapp.com",
            databaseURL: "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
            projectId: "YOUR_PROJECT",
            storageBucket: "YOUR_PROJECT.appspot.com",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        // Initialize Firebase
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.database();

        const { useState, useEffect } = React;

        function App() {
            const [view, setView] = useState('patient');
            const [queue, setQueue] = useState([]);
            const [phoneInput, setPhoneInput] = useState('');
            const [patientHistory, setPatientHistory] = useState([]);
            const [myToken, setMyToken] = useState(null);

            const [formData, setFormData] = useState({
                name: '', phone: '', age: '', gender: 'Male', symptoms: '', history: ''
            });

            // Realtime Sync with Firebase
            useEffect(() => {
                const queueRef = db.ref('queue');
                queueRef.on('value', (snapshot) => {
                    const data = snapshot.val();
                    if (data) {
                        const queueList = Object.keys(data).map(key => ({ id: key, ...data[key] }));
                        setQueue(queueList);
                    } else {
                        setQueue([]);
                    }
                });
            }, []);

            // Search Past History by Phone
            const fetchHistory = (phone) => {
                if (!phone) return;
                db.ref('history').orderByChild('phone').equalTo(phone).once('value', (snapshot) => {
                    const data = snapshot.val();
                    if (data) {
                        const historyList = Object.values(data);
                        setPatientHistory(historyList);
                    } else {
                        setPatientHistory([]);
                    }
                });
            };

            // Patient Book Token
            const handleBookToken = (e) => {
                e.preventDefault();
                const tokenNum = `T-${queue.length + 1}`;
                const newPatient = {
                    token: tokenNum,
                    ...formData,
                    status: 'Waiting',
                    timestamp: Date.now()
                };

                const newRef = db.ref('queue').push();
                newRef.set(newPatient);
                setMyToken({ ...newPatient, id: newRef.key });
                fetchHistory(formData.phone);
            };

            // Doctor Action: Call Next
            const handleNext = () => {
                const active = queue.find(q => q.status === 'In-Consultation');
                if (active) {
                    // Save to Permanent History
                    db.ref('history').push({
                        ...active,
                        completedAt: new Date().toLocaleDateString()
                    });
                    // Remove from active queue
                    db.ref(`queue/${active.id}`).remove();
                }

                const waiting = queue.find(q => q.status === 'Waiting');
                if (waiting) {
                    db.ref(`queue/${waiting.id}`).update({ status: 'In-Consultation' });
                    fetchHistory(waiting.phone);
                }
            };

            const activePatient = queue.find(q => q.status === 'In-Consultation');

            return (
                <div class="min-h-screen flex flex-col">
                    <header class="bg-indigo-600 text-white p-4 flex justify-between items-center shadow-lg">
                        <h1 class="text-xl font-bold tracking-wide">⚡ MediFlow SaaS</h1>
                        <div class="flex gap-2 bg-indigo-700 p-1 rounded-lg text-xs font-semibold">
                            <button onClick={() => setView('patient')} class={`px-3 py-1.5 rounded ${view === 'patient' ? 'bg-white text-indigo-600' : ''}`}>Patient Portal</button>
                            <button onClick={() => setView('doctor')} class={`px-3 py-1.5 rounded ${view === 'doctor' ? 'bg-white text-indigo-600' : ''}`}>Doctor Panel</button>
                            <button onClick={() => setView('tv')} class={`px-3 py-1.5 rounded ${view === 'tv' ? 'bg-white text-indigo-600' : ''}`}>TV Screen</button>
                        </div>
                    </header>

                    <main class="flex-grow p-4 md:p-8 max-w-6xl mx-auto w-full">
                        {/* 1. PATIENT VIEW */}
                        {view === 'patient' && (
                            <div class="grid md:grid-cols-2 gap-6">
                                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                                    <h2 class="text-lg font-bold mb-4">Book Token & Intake Form</h2>
                                    {!myToken ? (
                                        <form onSubmit={handleBookToken} class="space-y-3 text-sm">
                                            <input required type="text" placeholder="Full Name" class="w-full border p-2.5 rounded-lg" value={formData.name} onChange={e=>setFormData({...formData, name: e.target.value})} />
                                            <input required type="tel" placeholder="Mobile Number" class="w-full border p-2.5 rounded-lg" value={formData.phone} onChange={e=>setFormData({...formData, phone: e.target.value})} />
                                            <div class="flex gap-2">
                                                <input required type="number" placeholder="Age" class="w-1/2 border p-2.5 rounded-lg" value={formData.age} onChange={e=>setFormData({...formData, age: e.target.value})} />
                                                <select class="w-1/2 border p-2.5 rounded-lg" value={formData.gender} onChange={e=>setFormData({...formData, gender: e.target.value})}>
                                                    <option>Male</option><option>Female</option>
                                                </select>
                                            </div>
                                            <textarea required placeholder="Current Symptoms (Su dikkat chhe?)" class="w-full border p-2.5 rounded-lg" value={formData.symptoms} onChange={e=>setFormData({...formData, symptoms: e.target.value})}></textarea>
                                            <input type="text" placeholder="Past Allergies / BP / Diabetes (Optional)" class="w-full border p-2.5 rounded-lg" value={formData.history} onChange={e=>setFormData({...formData, history: e.target.value})} />
                                            <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-lg shadow">Get Live Token</button>
                                        </form>
                                    ) : (
                                        <div class="bg-indigo-50 border border-indigo-200 p-6 rounded-xl text-center">
                                            <div class="text-xs font-bold text-indigo-600">YOUR TOKEN NUMBER</div>
                                            <div class="text-6xl font-extrabold text-indigo-900 my-2">{myToken.token}</div>
                                            <p class="text-sm text-indigo-700 font-semibold">{myToken.name}</p>
                                        </div>
                                    )}
                                </div>

                                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                                    <h2 class="text-lg font-bold mb-4">Live Queue Status</h2>
                                    <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center mb-6">
                                        <div class="text-xs font-bold text-emerald-600">NOW SERVING</div>
                                        <div class="text-4xl font-extrabold text-emerald-800">{activePatient ? activePatient.token : 'None'}</div>
                                    </div>
                                    <h3 class="text-xs font-bold text-slate-500 uppercase mb-2">Waiting Line ({queue.filter(q=>q.status==='Waiting').length})</h3>
                                    <div class="space-y-2 max-h-60 overflow-y-auto">
                                        {queue.filter(q=>q.status==='Waiting').map((item, idx) => (
                                            <div key={item.id} class="flex justify-between p-3 bg-slate-50 rounded-lg text-sm border">
                                                <span class="font-bold">{item.token} - {item.name}</span>
                                                <span class="text-xs bg-slate-200 px-2 py-1 rounded">#{idx + 1}</span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        )}

                        {/* 2. DOCTOR VIEW */}
                        {view === 'doctor' && (
                            <div class="grid md:grid-cols-3 gap-6">
                                <div class="bg-white p-6 rounded-2xl shadow-sm border col-span-1">
                                    <button onClick={handleNext} class="w-full bg-emerald-600 text-white font-bold py-3 rounded-lg shadow mb-4">Call Next Patient ➔</button>
                                    <h3 class="text-xs font-bold text-slate-500 uppercase mb-2">Waiting Queue</h3>
                                    <div class="space-y-2 max-h-80 overflow-y-auto">
                                        {queue.filter(q=>q.status==='Waiting').map((item) => (
                                            <div key={item.id} class="p-3 bg-slate-50 rounded border text-xs">
                                                <div class="font-bold">{item.token} - {item.name}</div>
                                                <div class="text-slate-500 truncate">{item.symptoms}</div>
                                            </div>
                                        ))}
                                    </div>
                                </div>

                                <div class="bg-white p-6 rounded-2xl shadow-sm border col-span-2">
                                    <h2 class="text-md font-bold mb-4 border-b pb-2">Active Consultation</h2>
                                    {activePatient ? (
                                        <div class="space-y-4 text-sm">
                                            <div class="bg-indigo-50 p-4 rounded-xl flex justify-between font-bold text-indigo-900">
                                                <span>{activePatient.token} | {activePatient.name} ({activePatient.age} Yrs)</span>
                                                <span>📞 {activePatient.phone}</span>
                                            </div>
                                            <div class="grid grid-cols-2 gap-4">
                                                <div class="bg-slate-50 p-3 rounded border">
                                                    <span class="text-xs text-slate-400 font-bold block">TODAY'S SYMPTOMS</span>
                                                    <p class="font-semibold">{activePatient.symptoms}</p>
                                                </div>
                                                <div class="bg-slate-50 p-3 rounded border">
                                                    <span class="text-xs text-slate-400 font-bold block">KNOWN HISTORY</span>
                                                    <p class="font-semibold">{activePatient.history || "None"}</p>
                                                </div>
                                            </div>

                                            {/* REPEAT PATIENT PAST HISTORY DISPLAY */}
                                            <div class="mt-4">
                                                <h4 class="text-xs font-bold text-indigo-600 uppercase mb-2">📋 Past Visit History ({patientHistory.length})</h4>
                                                <div class="space-y-2 max-h-40 overflow-y-auto bg-slate-50 p-3 rounded border">
                                                    {patientHistory.length > 0 ? patientHistory.map((h, i) => (
                                                        <div key={i} class="text-xs border-b pb-1">
                                                            <span class="text-slate-400">{h.completedAt}</span>: <b>{h.symptoms}</b>
                                                        </div>
                                                    )) : <span class="text-xs text-slate-400">First time visit. No past history found.</span>}
                                                </div>
                                            </div>
                                        </div>
                                    ) : <div class="text-center py-12 text-slate-400 text-sm">No active patient inside. Click "Call Next".</div>}
                                </div>
                            </div>
                        )}

                        {/* 3. TV DISPLAY */}
                        {view === 'tv' && (
                            <div class="bg-slate-900 text-white rounded-3xl p-12 text-center shadow-2xl">
                                <span class="text-emerald-400 font-bold uppercase tracking-widest text-sm">Waiting Area Display</span>
                                <h1 class="text-2xl text-slate-400 mt-6">NOW SERVING TOKEN</h1>
                                <div class="text-9xl font-extrabold text-emerald-400 my-4 animate-pulse">{activePatient ? activePatient.token : '---'}</div>
                            </div>
                        )}
                    </main>
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
